# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow?schema=public"

# JWT signing secrets — generate long random strings, never reuse across environments
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TTL="15m"
REFRESH_TTL="7d"

# SMTP — leave blank in dev to fall back to an Ethereal test account
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dayflow <no-reply@dayflow.app>"

# Public URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"

# Local uploads
UPLOAD_DIR="./uploads"

NODE_ENV="development"
PORT="4000"
