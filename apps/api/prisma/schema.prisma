// M1 ONLY — see docs/Dayflow-Team-Plan.md §3.1. Nobody else edits this file.
// Post a `SCHEMA REQUEST` in the team channel for changes; M1 applies them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  EXITED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  SELF
  ADMIN
  SYSTEM
}

enum TimeOffTypeCode {
  PAID
  SICK
  UNPAID
}

enum AllocationStatus {
  DRAFT
  APPROVED
  REFUSED
}

enum HalfDay {
  NONE
  FIRST_HALF
  SECOND_HALF
}

enum TimeOffRequestStatus {
  TO_APPROVE
  APPROVED
  REFUSED
  CANCELLED
}

enum WageType {
  FIXED
}

enum ContractStatus {
  DRAFT
  RUNNING
  EXPIRED
}

enum ComponentCategory {
  EARNING
  EMPLOYEE_DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum ComponentComputation {
  FIXED
  PCT_OF_WAGE
  PCT_OF_COMPONENT
  BALANCE
}

enum PayslipStatus {
  DRAFT
  PUBLISHED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ── Platform ─────────────────────────────────────────────────────────────

model Company {
  id                    String   @id @default(cuid())
  name                  String   @unique
  code                  String
  logoUrl               String?
  address               String?
  timezone              String   @default("Asia/Kolkata")
  workDaysPerWeek       Int      @default(5)
  standardDailyHours    Int      @default(8)
  breakMinutes          Int      @default(60)
  pfRateEmployee        Decimal  @default(12) @db.Decimal(5, 2)
  pfRateEmployer        Decimal  @default(12) @db.Decimal(5, 2)
  professionalTax       Decimal  @default(200) @db.Decimal(12, 2)
  serialWidth           Int      @default(4)
  coverageOkThreshold   Int      @default(70)
  coverageRiskThreshold Int      @default(50)
  absenceCutoffHour     Int      @default(11)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users              User[]
  employees          Employee[]
  departments        Department[]
  timeOffTypes       TimeOffType[]
  holidays           Holiday[]
  settings           Setting[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  loginIdCounters    LoginIdCounter[]
  attendanceRecords  AttendanceRecord[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  contracts          Contract[]
  payslips           Payslip[]
  documents          Document[]
}

model User {
  id                 String     @id @default(cuid())
  companyId          String
  loginId            String     @unique
  email              String     @unique
  phone              String?
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  role               Role
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  employee      Employee?
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@index([companyId])
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  familyId            String
  tokenHash           String    @unique
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  tokenHash String            @unique
  purpose   EmailTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginIdCounter {
  id         String @id @default(cuid())
  companyId  String
  year       Int
  lastSerial Int    @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, year])
}

model Department {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  headEmployeeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([companyId, createdAt])
}

model Document {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  name         String
  url          String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// ── Employees ────────────────────────────────────────────────────────────

model Employee {
  id            String         @id @default(cuid())
  userId        String         @unique
  companyId     String
  firstName     String
  lastName      String
  avatarUrl     String?
  departmentId  String?
  managerId     String?
  jobTitle      String?
  workLocation  String?
  joinedOn      DateTime       @db.Date
  joiningYear   Int
  joiningSerial Int
  shiftStart    String         @default("09:00")
  shiftEnd      String         @default("18:00")
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  manager    Employee?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports    Employee[]  @relation("ManagerReports")

  privateInfo        PrivateInfo?
  resume             Resume?
  attendanceRecords  AttendanceRecord[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  contracts          Contract[]
  payslips           Payslip[]
  documents          Document[]

  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
}

model PrivateInfo {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  dateOfBirth       DateTime? @db.Date
  nationality       String?
  personalEmail     String?
  gender            String?
  maritalStatus     String?
  permanentAddress  String?
  bankAccountNumber String?
  bankName          String?
  ifscCode          String?
  panNumber         String?
  uanNumber         String?
  employeeCode      String?
  aadhaarLast4      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Resume {
  id         String   @id @default(cuid())
  employeeId String   @unique
  about      String?
  jobLove    String?
  interests  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee       Employee        @relation(fields: [employeeId], references: [id])
  skills         Skill[]
  certifications Certification[]
}

model Skill {
  id        String   @id @default(cuid())
  resumeId  String
  name      String
  level     String?
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Certification {
  id        String    @id @default(cuid())
  resumeId  String
  name      String
  issuer    String?
  issuedOn  DateTime? @db.Date
  url       String?
  createdAt DateTime  @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

// ── Attendance ───────────────────────────────────────────────────────────

model AttendanceRecord {
  id           String           @id @default(cuid())
  companyId    String
  employeeId   String
  date         DateTime         @db.Date
  status       AttendanceStatus
  firstCheckIn DateTime?
  lastCheckOut DateTime?
  workMinutes  Int              @default(0)
  breakMinutes Int              @default(0)
  extraMinutes Int              @default(0)
  source       AttendanceSource @default(SELF)
  note         String?
  editedById   String?
  editedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company  Company             @relation(fields: [companyId], references: [id])
  employee Employee            @relation(fields: [employeeId], references: [id])
  sessions AttendanceSession[]

  @@unique([employeeId, date])
  @@index([companyId, date])
}

model AttendanceSession {
  id                 String    @id @default(cuid())
  attendanceRecordId String
  inAt               DateTime
  outAt              DateTime?
  createdAt          DateTime  @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
}

// ── Time off ─────────────────────────────────────────────────────────────

model TimeOffType {
  id                    String          @id @default(cuid())
  companyId             String
  name                  String
  code                  TimeOffTypeCode
  isPaid                Boolean         @default(true)
  requiresAttachment    Boolean         @default(false)
  colorToken            String?
  defaultAllocationDays Decimal         @default(0) @db.Decimal(5, 1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]
  Company     Company             @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model TimeOffAllocation {
  id            String           @id @default(cuid())
  companyId     String
  employeeId    String
  typeId        String
  days          Decimal          @db.Decimal(5, 1)
  validFrom     DateTime         @db.Date
  validTo       DateTime?        @db.Date
  status        AllocationStatus @default(APPROVED)
  allocatedById String?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  type     TimeOffType @relation(fields: [typeId], references: [id])

  @@index([employeeId, typeId])
}

model TimeOffRequest {
  id              String               @id @default(cuid())
  companyId       String
  employeeId      String
  typeId          String
  startDate       DateTime             @db.Date
  endDate         DateTime             @db.Date
  halfDay         HalfDay              @default(NONE)
  days            Decimal              @db.Decimal(4, 1)
  reason          String?
  attachmentUrl   String?
  status          TimeOffRequestStatus @default(TO_APPROVE)
  decidedById     String?
  decidedAt       DateTime?
  decisionComment String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  type     TimeOffType @relation(fields: [typeId], references: [id])

  @@index([status, startDate])
  @@index([employeeId, status])
}

// ── Payroll ──────────────────────────────────────────────────────────────

model Contract {
  id              String         @id @default(cuid())
  companyId       String
  employeeId      String
  effectiveFrom   DateTime       @db.Date
  wageType        WageType       @default(FIXED)
  monthlyWage     Decimal        @db.Decimal(12, 2)
  yearlyWage      Decimal        @db.Decimal(14, 2)
  workDaysPerWeek Int
  breakHours      Decimal        @db.Decimal(4, 2)
  createdById     String
  status          ContractStatus @default(RUNNING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  employee   Employee          @relation(fields: [employeeId], references: [id])
  components SalaryComponent[]

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId])
}

model SalaryComponent {
  id                String               @id @default(cuid())
  contractId        String
  sequence          Int
  name              String
  code              String
  category          ComponentCategory
  computation       ComponentComputation
  value             Decimal              @db.Decimal(9, 4)
  baseComponentCode String?
  computedAmount    Decimal              @db.Decimal(12, 2)
  createdAt         DateTime             @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, code])
}

model Payslip {
  id                    String        @id @default(cuid())
  companyId             String
  employeeId            String
  contractIdSnapshot    String?
  month                 Int
  year                  Int
  totalWorkingDays      Decimal       @db.Decimal(5, 1)
  payableDays           Decimal       @db.Decimal(5, 1)
  unpaidLeaveDays       Decimal       @db.Decimal(5, 1)
  missingAttendanceDays Decimal       @db.Decimal(5, 1)
  perDayRate            Decimal       @db.Decimal(12, 2)
  lossOfPay             Decimal       @db.Decimal(12, 2)
  grossEarnings         Decimal       @db.Decimal(12, 2)
  totalDeductions       Decimal       @db.Decimal(12, 2)
  netPay                Decimal       @db.Decimal(12, 2)
  status                PayslipStatus @default(DRAFT)
  pdfUrl                String?
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company  Company       @relation(fields: [companyId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([employeeId, month, year])
  @@index([employeeId, year, month])
}

model PayslipLine {
  id        String            @id @default(cuid())
  payslipId String
  label     String
  category  ComponentCategory
  amount    Decimal           @db.Decimal(12, 2)
  createdAt DateTime          @default(now())

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}
